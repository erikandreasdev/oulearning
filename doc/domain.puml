@startuml
skinparam classAttributeIconSize 0
hide empty members

title Domain Layer Model

package organization.hierarchy {
  class OrganizationalUnit << (R, #FF7700) record >> {
    OrganizationalUnitId id
    Name name
    OrganizationalUnitId rawParentId
    Set<OrganizationalUnitId> childIds
    Set<EmployeeId> owners
    Set<EmployeeId> members
    boolean active
    + {static} OrganizationalUnit create(OrganizationalUnitId, Name, OrganizationalUnitId)
    + {static} OrganizationalUnit reconstitute(OrganizationalUnitId, Name, OrganizationalUnitId, Set, Set, Set, boolean)
    + OrganizationalUnit rename(Name newName)
    + OrganizationalUnit addOwner(EmployeeId ownerId)
    + OrganizationalUnit removeOwner(EmployeeId ownerId)
    + OrganizationalUnit addOwners(Set<EmployeeId> ownerIds)
    + OrganizationalUnit removeOwners(Set<EmployeeId> ownerIds)
    + OrganizationalUnit addMember(EmployeeId memberId)
    + OrganizationalUnit removeMember(EmployeeId memberId)
    + OrganizationalUnit addMembers(Set<EmployeeId> memberIds)
    + OrganizationalUnit removeMembers(Set<EmployeeId> memberIds)
    + OrganizationalUnit deactivate()
    + Optional<OrganizationalUnitId> parentId()
  }

  class Organization << (R, #FF7700) record >> {
    Set<OrganizationalUnitId> organizationalUnitIds
    + Organization addOrganizationalUnit(OrganizationalUnitId ouId)
    + Organization removeOrganizationalUnit(OrganizationalUnitId ouId)
  }

  class OrganizationalUnitId << (R, #FF7700) record >> {
    long value
    + {static} OrganizationalUnitId of(long value)
  }

  class Name << (R, #FF7700) record >> {
    String value
    + {static} Name of(String value)
  }

  interface OrganizationalUnitRepository << (I, #00FF77) >> {
    + Optional<OrganizationalUnit> findById(OrganizationalUnitId id)
    + void save(OrganizationalUnit organizationalUnit)
  }

  interface IdGenerator << (I, #00FF77) >> {
    + long generate()
  }
}

package organization.employee {
  class FullName << (R, #FF7700) record >> {
    Name name
    Surname surname
    + {static} FullName of(Name name, Surname surname)
    + {static} FullName of(String name, String surname)
    + String formatted()
  }

  class Surname << (R, #FF7700) record >> {
    String value
    + {static} Surname of(String value)
  }

  class Email << (R, #FF7700) record >> {
    String value
    + {static} Email of(String value)
  }

  class EmployeeId << (R, #FF7700) record >> {
    long value
    + {static} EmployeeId of(long value)
  }

  class Name << (R, #FF7700) record >> {
    String value
    + {static} Name of(String value)
  }

  class Employee << (R, #FF7700) record >> {
    EmployeeId id
    FullName fullName
    Email email
    boolean active
    + {static} Employee create(EmployeeId, FullName, Email)
    + {static} Employee reconstitute(EmployeeId, FullName, Email, boolean)
    + Employee updateFullName(FullName newFullName)
    + Employee updateEmail(Email newEmail)
    + Employee deactivate()
  }

  interface EmployeeRepository << (I, #00FF77) >> {
    + Optional<Employee> findById(EmployeeId id)
    + void save(Employee employee)
  }

  interface IdGenerator << (I, #00FF77) >> {
    + long generate()
  }
}

package budgeting {
  class FiscalYear << (R, #FF7700) record >> {
    int value
    + {static} FiscalYear of(int value)
  }

  class Budget << (R, #FF7700) record >> {
    BudgetId id
    OrganizationalUnitId organizationalUnitId
    FiscalYear fiscalYear
    Money total
    Money reserved
    Money available
    boolean active
    + {static} Budget create(BudgetId, OrganizationalUnitId, FiscalYear, Money, Money, Money)
    + {static} Budget reconstitute(BudgetId, OrganizationalUnitId, FiscalYear, Money, Money, Money, boolean)
    + Budget updateAmounts(Money total, Money reserved, Money available)
    + Budget deactivate()
  }

  class BudgetId << (R, #FF7700) record >> {
    long value
    + {static} BudgetId of(long value)
  }

  class Money << (R, #FF7700) record >> {
    MonetaryAmount monetaryAmount
    + {static} Money of(BigDecimal amount)
    + {static} Money of(double amount)
    + {static} Money zero()
    + BigDecimal amount()
    + String currency()
    + Money add(Money other)
    + Money subtract(Money other)
    + boolean isGreaterThan(Money other)
    + boolean isLessThan(Money other)
  }

  interface BudgetRepository << (I, #00FF77) >> {
    + Optional<Budget> findById(BudgetId id)
    + void save(Budget budget)
  }

  interface IdGenerator << (I, #00FF77) >> {
    + long generate()
  }
}

package training {
  class ManagerReview << (R, #FF7700) record >> {
    String comments
    Modality modality
    Instant startDate
    Instant endDate
    ExternalProviderId externalProviderId
    Instant reviewedAt
    + Optional<ExternalProviderId> optionalExternalProviderId()
  }

  enum TrainingPurposeType {
    INDIVIDUAL_DEVELOPMENT_PLAN
    DEPARTMENT_GOALS
    OTHER
  }

  class TrainingPurpose << (R, #FF7700) record >> {
    TrainingPurposeType type
    String otherPurpose
    + {static} TrainingPurpose individualDevelopmentPlan()
    + {static} TrainingPurpose departmentGoals()
    + {static} TrainingPurpose other(String purpose)
    + Optional<String> optionalOtherPurpose()
  }

  class Phone << (R, #FF7700) record >> {
    String value
    + {static} Phone of(String value)
  }

  class Type << (R, #FF7700) record >> {
    TypeId id
    TypeName name
    TypeId rawParentTypeId
    + {static} Type of(TypeId, TypeName, TypeId)
    + Optional<TypeId> parentTypeId()
  }

  class TypeName << (R, #FF7700) record >> {
    String value
    + {static} TypeName of(String value)
  }

  enum TrainingStatus {
    REQUESTED
    APPROVED
    REJECTED
  }

  class TrainingId << (R, #FF7700) record >> {
    long value
    + {static} TrainingId of(long value)
  }

  class Hours << (R, #FF7700) record >> {
    int value
    + {static} Hours of(int value)
  }

  enum Modality {
    VIRTUAL
    ON_SITE
    E_LEARNING
    BLENDED
  }

  class ExternalProviderContact << (R, #FF7700) record >> {
    Email email
    Phone phone
    + {static} ExternalProviderContact of(Email, Phone)
  }

  class ExternalProviderId << (R, #FF7700) record >> {
    long value
    + {static} ExternalProviderId of(long value)
  }

  class ExternalProviderName << (R, #FF7700) record >> {
    String value
    + {static} ExternalProviderName of(String value)
  }

  class ExternalProvider << (R, #FF7700) record >> {
    ExternalProviderId id
    ExternalProviderName name
    ExternalProviderContact contact
    boolean active
    + {static} ExternalProvider create(ExternalProviderId, ExternalProviderName, ExternalProviderContact)
    + {static} ExternalProvider reconstitute(ExternalProviderId, ExternalProviderName, ExternalProviderContact, boolean)
    + ExternalProvider update(ExternalProviderName, ExternalProviderContact)
    + ExternalProvider deactivate()
  }

  class TypeId << (R, #FF7700) record >> {
    long value
    + {static} TypeId of(long value)
  }

  class Cost << (R, #FF7700) record >> {
    BigDecimal amount
    String currency
    + {static} Cost of(BigDecimal amount, String currency)
    + {static} Cost of(BigDecimal amount)
    + {static} Cost zero()
  }

  class Training << (R, #FF7700) record >> {
    TrainingId id
    EmployeeId requestedBy
    OrganizationalUnitId organizationalUnitId
    TrainingName name
    Cost cost
    Hours hours
    TrainingPurpose purpose
    TypeId typeId
    TrainingStatus status
    ManagerReview rawManagerReview
    Instant createdAt
    Instant updatedAt
    Set<EmployeeId> attendees
    boolean active
    + {static} Training create(TrainingId, EmployeeId, OrganizationalUnitId, TrainingName, Cost, Hours, TrainingPurpose, TypeId, Instant)
    + {static} Training reconstitute(...)
    + Training updateDetails(TrainingName, Cost, Hours, TrainingPurpose, TypeId, Instant)
    + Training approve(ManagerReview review, Instant now)
    + Training reject(ManagerReview review, Instant now)
    + Training addAttendee(EmployeeId attendee, Instant now)
    + Training deactivate()
    + Optional<ManagerReview> managerReview()
  }

  class TrainingName << (R, #FF7700) record >> {
    String value
    + {static} TrainingName of(String value)
  }

  interface TrainingRepository << (I, #00FF77) >> {
    + Optional<Training> findById(TrainingId id)
    + void save(Training training)
  }

  interface ExternalProviderRepository << (I, #00FF77) >> {
    + Optional<ExternalProvider> findById(ExternalProviderId id)
    + void save(ExternalProvider externalProvider)
  }

  interface IdGenerator << (I, #00FF77) >> {
    + long generate()
  }
}

Budget --> BudgetId : id
Budget --> OrganizationalUnitId : organizationalUnitId
Budget --> FiscalYear : fiscalYear
Budget --> Money : total
Budget --> Money : reserved
Budget --> Money : available

OrganizationalUnit --> OrganizationalUnitId : id
OrganizationalUnit --> Name : name
OrganizationalUnit --> OrganizationalUnitId : rawParentId
OrganizationalUnit "1" --> "*" OrganizationalUnitId : childIds
OrganizationalUnit "1" --> "*" EmployeeId : owners
OrganizationalUnit "1" --> "*" EmployeeId : members
Organization "1" --> "*" OrganizationalUnitId : organizationalUnitIds

FullName --> Name : name
FullName --> Surname : surname
Employee --> EmployeeId : id
Employee --> FullName : fullName
Employee --> Email : email

ManagerReview --> Modality : modality
ManagerReview --> ExternalProviderId : externalProviderId
TrainingPurpose --> TrainingPurposeType : type
Type --> TypeId : id
Type --> TypeName : name
Type --> TypeId : rawParentTypeId
ExternalProviderContact --> Email : email
ExternalProviderContact --> Phone : phone
ExternalProvider --> ExternalProviderId : id
ExternalProvider --> ExternalProviderName : name
ExternalProvider --> ExternalProviderContact : contact

Training --> TrainingId : id
Training --> EmployeeId : requestedBy
Training --> OrganizationalUnitId : organizationalUnitId
Training --> TrainingName : name
Training --> Cost : cost
Training --> Hours : hours
Training --> TrainingPurpose : purpose
Training --> TypeId : typeId
Training --> TrainingStatus : status
Training --> ManagerReview : rawManagerReview
Training "1" --> "*" EmployeeId : attendees

@enduml
