meta {
  name: Import Organization Excel
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/organization/import
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(/Users/erik/dev/oulearning/Employee_Hierarchy_Template.xlsx) @contentType(application/vnd.openxmlformats-officedocument.spreadsheetml.sheet)
}

vars:pre-request {
  baseUrl: http://localhost:8080
}
