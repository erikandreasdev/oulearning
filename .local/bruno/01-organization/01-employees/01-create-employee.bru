meta {
  name: Create Employee
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/employees
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{employeeName}}",
    "surname": "{{employeeSurname}}",
    "email": "{{employeeEmail}}"
  }
}

vars:post-response {
  employeeId: res.body.id
}
