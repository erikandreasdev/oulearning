meta {
  name: Update Employee
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/employees/{{employeeId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{updatedEmployeeName}}",
    "surname": "{{updatedEmployeeSurname}}",
    "email": "{{updatedEmployeeEmail}}"
  }
}
