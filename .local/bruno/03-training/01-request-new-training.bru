meta {
  name: Request New Training
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/trainings/requests
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "requestedBy": {{employeeId}},
    "organizationalUnitId": {{ouId}},
    "name": "{{trainingName}}",
    "costAmount": {{trainingCostAmount}},
    "costCurrency": "{{trainingCostCurrency}}",
    "hours": {{trainingHours}},
    "purposeType": "{{trainingPurposeType}}",
    "typeId": {{trainingTypeId}},
    "attendees": [
      {{employeeId}}
    ]
  }
}

vars:post-response {
  trainingId: res.body.id
}
