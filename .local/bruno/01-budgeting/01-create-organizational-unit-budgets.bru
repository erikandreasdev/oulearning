meta {
  name: Create Organizational Unit Budgets
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/budgets/organizational-unit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "assignedBudget": {{assignedBudget}},
    "fiscalYear": {{fiscalYear}},
    "organizationalUnitId": {{ouId}},
    "owners": [10],
    "includeAllChildren": false,
    "targetChildOuIds": [],
    "page": 0,
    "size": 20
  }
}

vars:pre-request {
  assignedBudget: 10000
  fiscalYear: 2026
  ouId: 106
  baseUrl: http://localhost:8080
}
